# ==============================================================================
# CareerPilot AI - Environment Configuration
# ==============================================================================

# Core Server Configuration (Render automatically sets PORT to 10000)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database URI (Required for live deployment on Render)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careerpilot_ai?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careerpilot_ai?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=generate_a_long_random_64_character_hex_string_here

# Google Gemini AI API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Restrict CORS to specific frontend domains (comma-separated, or leave empty for all)
# ALLOWED_ORIGINS=https://careerpilot.vercel.app,https://careerpilot.netlify.app

# ==============================================================================
# EMAIL SERVICE FOR RENDER DEPLOYMENT (HTTPS Port 443)
# Render blocks outbound SMTP ports 25, 465, and 587 on free/starter tiers.
# Use an HTTP API provider below to send emails reliably from Render.
# ==============================================================================

# OPTION 1: Resend HTTP API (RECOMMENDED FOR RENDER)
# Get free API key (100 emails/day, 3,000/month) at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM="CareerPilot AI <onboarding@resend.dev>"

# OPTION 2: Brevo (Sendinblue) HTTP API (100% Free, 300 emails/day)
# Get free API key at https://brevo.com
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# BREVO_SENDER_EMAIL=your_verified_sender@example.com

# OPTION 3: SendGrid HTTP API
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# SENDGRID_FROM=your_verified_sender@example.com

# ==============================================================================
# LOCAL DEVELOPMENT ONLY (SMTP / Nodemailer)
# Note: These will NOT work on Render free tier due to Render port blocks.
# ==============================================================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_google_app_password
EMAIL_FROM="CareerPilot AI <your_email@gmail.com>"
