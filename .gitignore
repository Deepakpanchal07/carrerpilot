# ==========================================
# CareerPilot AI - Root Git Ignore
# ==========================================

# Sensitive Environment Variables (NEVER commit secrets to Git)
.env
*.env
!.env.example
backend/.env

# Node.js dependencies
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter & Dart build artifacts
.dart_tool/
frontend/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
frontend/build/

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

